---
# Copy to group_vars/all.yml (or use ansible-vault) — do not commit secrets.

# Workshop AAP + MCP endpoints
aap_base_url: https://aap-aap.apps.cluster-wg2cd-2.dynamic2.redhatworkshops.io
aap_mcp_base_url: https://aap-mcp-aap.apps.cluster-wg2cd-2.dynamic2.redhatworkshops.io
aap_mcp_server_path: /mcp

aap_user: admin
aap_password: ""
# Optional: skip token creation if already set
# aap_gateway_token: ""

# Azure AI Foundry
foundry_account: foundry-wg2cd-1
foundry_project: foundry-wg2cd-1-project
foundry_rg: openenv-wg2cd-1
foundry_sub: 9dc2c3d2-35a8-4370-8997-b56a57b5778d
foundry_project_endpoint: ""  # or full https://….services.ai.azure.com/api/projects/…

foundry_model_deployment_name: gpt-4o
foundry_mcp_connection_name: aap-mcp-bearer
foundry_agent_name: aap-automation-agent
foundry_mcp_server_label: ansible-aap
foundry_mcp_require_approval: always

foundry_verify_mcp_before_register: true
foundry_verify_mcp_tools_list: true
foundry_register_agent: true
foundry_register_connection_arm: true
foundry_validate_certs: false

# Cleanup / redeploy (playbooks/cleanup-foundry.yml, redeploy.yml)
foundry_delete_extra_projects: false
foundry_extra_projects_to_delete:
  - wg2cd-mcp
  - wg2cd-project

# OpenShift (playbooks/verify.yml, openshift-mcp-routes.yml)
# ocp_token: sha256~…
ocp_api_url: https://api.cluster-wg2cd-2.dynamic2.redhatworkshops.io:6443

# Optional: set instead of `az account get-access-token`
# foundry_agent_token: ""
# foundry_mgmt_token: ""

# Launch playbook (playbooks/launch-job-template.yml)
# aap_launch_job_template_id: "13"
