# RHPDS workshop AAP MCP (no Azure AI Foundry)
AAP_MCP_URL=https://aap-mcp-aap.apps.cluster-wg2cd-2.dynamic2.redhatworkshops.io/job_management/mcp
# Or full catalog (large): .../mcp

# Mint: ansible-playbook playbooks/create-gateway-token.yml -e @group_vars/all.yml
AAP_GATEWAY_TOKEN=

# Optional: AAP_PASSWORD + AAP_USER if token empty (script mints token)
# AAP_BASE_URL=https://aap-aap.apps.cluster-wg2cd-2.dynamic2.redhatworkshops.io
# AAP_USER=admin
# AAP_PASSWORD=

# GitHub Copilot SDK model (requires: gh auth login && gh auth refresh --scopes copilot)
COPILOT_MODEL=gpt-4.1

# Optional Azure BYOM (Azure OpenAI / AI Services — not Foundry Agent Service)
# AZURE_OPENAI_ENDPOINT=https://foundry-wg2cd-1.openai.azure.com
# AZURE_MODEL_NAME=o4-mini
