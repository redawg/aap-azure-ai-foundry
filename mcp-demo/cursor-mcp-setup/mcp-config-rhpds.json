    "aap-user": {
      "type": "streamable-http",
      "url": "https://${env:AAP_MCP_BASE}/user_management/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MY_SERVICE_TOKEN}"
      }
    },
    "aap-sec": {
      "type": "streamable-http",
      "url": "https://${env:AAP_MCP_BASE}/security_compliance/mcp",
      "headers": {
        "Authorization": "Bearer ${env:MY_SERVICE_TOKEN}"
